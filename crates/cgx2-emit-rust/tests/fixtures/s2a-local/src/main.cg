module app.main
record Point:
    x: i64
variant Flag:
    Off
    Value(Point)
record Holder:
    flag: Flag
    point: Point
    maybe: Option<Flag>
    outcome: Result<Point, Flag>
    nested: Option<Result<Point, Flag>>
    reversed: Result<Option<Point>, Flag>
fn flag_value(flag: Flag) -> i64 effects():
    match flag:
        Flag.Off:
            1
        Flag.Value(point):
            point.x
fn optional(value: Option<Flag>) -> i64 effects():
    match value:
        Option<Flag>.None:
            0
        Option<Flag>.Some(flag):
            flag_value(flag)
fn outcome(value: Result<Point, Flag>) -> i64 effects():
    match value:
        Result<Point, Flag>.Ok(point):
            point.x
        Result<Point, Flag>.Err(flag):
            flag_value(flag)
fn nested(value: Option<Result<Point, Flag>>) -> i64 effects():
    match value:
        Option<Result<Point, Flag>>.None:
            0
        Option<Result<Point, Flag>>.Some(result):
            outcome(result)
fn maybe_point(value: Option<Point>) -> i64 effects():
    match value:
        Option<Point>.None:
            0
        Option<Point>.Some(point):
            point.x
fn reversed(value: Result<Option<Point>, Flag>) -> i64 effects():
    match value:
        Result<Option<Point>, Flag>.Ok(point):
            maybe_point(point)
        Result<Option<Point>, Flag>.Err(flag):
            flag_value(flag)
fn main() -> i64 effects():
    let holder = Holder(flag: Flag.Value(Point(x: 10)), point: Point(x: 11), maybe: Option<Flag>.Some(Flag.Off()), outcome: Result<Point, Flag>.Ok(Point(x: 8)), nested: Option<Result<Point, Flag>>.Some(Result<Point, Flag>.Err(Flag.Value(Point(x: 5)))), reversed: Result<Option<Point>, Flag>.Ok(Option<Point>.Some(Point(x: 7))))
    let point = holder.point
    flag_value(holder.flag) + point.x + optional(holder.maybe) + outcome(holder.outcome) + nested(holder.nested) + reversed(holder.reversed)
