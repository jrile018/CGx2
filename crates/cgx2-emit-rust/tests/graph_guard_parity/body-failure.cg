fn main() -> Unit effects(ManagedAlloc, Mutate):
    let r = memory.region(mode: manual, limit: 1048576)
    let graph = memory.alloc_graph(r, 1, 0)
    no_gc(budget: 32):
        no_gc(budget: 0):
            if 1 == 1:
                let local = memory.owned_bytes(8)
                memory.drop(local)
            else:
                let other = memory.owned_bytes(0)
                memory.drop(other)
    memory.drop(graph)
    memory.close(r)
