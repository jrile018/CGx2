module exports
pub record Value:
    value: i64
pub record Wrapper<T>:
    value: T
pub variant Choice<T>:
    Value(T)
pub record Outer:
    value: Wrapper<Choice<Value>>
pub fn make() -> Outer effects() caps():
    Outer(value: Wrapper<Choice<Value>>(value: Choice<Value>.Value(Value(value: 7))))
pub fn wrapped() -> Wrapper<Value> effects() caps():
    Wrapper<Value>(value: Value(value: 7))
pub fn main() -> i64:
    let x = make()
    let y = wrapped()
    let value = y.value
    value.value
