let r = memory.region(mode: manual, limit: 256)
let x = memory.alloc_bytes(r, 16)
let owned = memory.owned_bytes(8)
let promoted = memory.promote_owned(r, owned)
memory.collect(r)
memory.use(x)
memory.use(promoted)
let copied = memory.copy_to_owned(promoted)
memory.drop(x)
memory.drop(promoted)
memory.collect(r)
memory.close(r)
memory.use(copied)
memory.drop(copied)
