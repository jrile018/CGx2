let r = memory.region(mode: manual, limit: 1024)
let a = memory.alloc_object(r, 0, 1)
let b = memory.alloc_object(r, 0, 1)
memory.set_reference(a, 0, b)
memory.set_reference(b, 0, a)
memory.drop(b)
memory.collect(r)
let live = memory.reference(a, 0)
memory.use_reference(live)
memory.drop(a)
memory.collect(r)
memory.close(r)
