pub fn graph() -> Unit effects(ManagedAlloc, Collect, Mutate) caps(MemoryCollect):
    let r = memory.region(mode: manual, limit: 1024)
    let a = memory.alloc_object(r, 8, 1)
    let b = memory.alloc_object(r, 4, 0)
    memory.set_reference(a, 0, b)
    memory.drop(b)
    let found = memory.reference(a, 0)
    memory.use_reference(found)
    memory.clear_reference(a, 0)
    memory.drop(a)
    memory.collect(r)
    memory.close(r)
fn main() -> Unit effects(ManagedAlloc, Collect, Mutate) caps(MemoryCollect):
    graph()
