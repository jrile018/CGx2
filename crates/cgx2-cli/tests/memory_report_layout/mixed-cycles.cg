let r = memory.region(mode: manual, limit: 8388608)
let head = memory.alloc_object(r, 1, 2)
let tail = memory.alloc_graph(r, 1, 65536)
memory.set_reference(head, 0, tail)
memory.set_reference(head, 1, tail)
memory.set_graph_reference(tail, 0, head)
memory.set_graph_reference(tail, 65535, tail)
let raw_alias = memory.reference(head, 0)
let graph_alias = memory.graph_reference(tail, 65535)
memory.use_reference(raw_alias)
memory.use_reference(graph_alias)
memory.expect_graph_byte(tail, 0, 0)
memory.expect_byte(head, 0, 1)
memory.drop(head)
memory.drop(tail)
memory.close(r)
