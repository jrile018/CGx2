let r = memory.region(mode: manual, limit: 8388608)
let bytes = memory.owned_bytes(24)
let moved = memory.move(bytes)
let tail = memory.promote_owned(r, moved)
let copied = memory.copy_to_owned(tail)
let head = memory.alloc_object(r, 1, 1)
memory.set_reference(head, 0, head)
let loan = memory.borrow(tail)
memory.use(tail)
memory.end_borrow(loan)
memory.expect_byte(head, 0, 1)
memory.drop(copied)
memory.drop(head)
memory.drop(tail)
memory.close(r)
