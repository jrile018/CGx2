let r = memory.region(mode: manual, limit: 8388608)
let head = memory.alloc_graph(r, 1, 65536)
let tail = memory.alloc_object(r, 1, 1)
memory.set_graph_reference(head, 65535, tail)
memory.set_reference(tail, 0, tail)
let alias = memory.graph_reference(head, 65535)
memory.drop(tail)
memory.use_reference(alias)
memory.expect_graph_byte(head, 0, 1)
memory.drop(head)
memory.close(r)
