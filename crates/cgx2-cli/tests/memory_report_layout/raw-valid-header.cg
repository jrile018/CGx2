let r = memory.region(mode: manual, limit: 8388608)
let head = memory.alloc_object(r, 24, 2)
let tail = memory.alloc_object(r, 1, 0)
memory.write_byte(head, 0, 67)
memory.write_byte(head, 1, 71)
memory.write_byte(head, 2, 71)
memory.write_byte(head, 3, 49)
memory.write_byte(head, 4, 1)
memory.write_byte(head, 12, 1)
memory.set_reference(head, 1, tail)
let first = memory.reference(head, 1)
let second = memory.reference(head, 1)
memory.use_reference(first)
memory.use_reference(second)
memory.expect_byte(head, 0, 0)
memory.drop(head)
memory.drop(tail)
memory.close(r)
