let r = memory.region(mode: manual, limit: 8388608)
let head = memory.alloc_object(r, 1, 1)
let tail = memory.alloc_graph(r, 0, 65536)
memory.set_reference(head, 0, tail)
memory.set_graph_reference(tail, 65535, tail)
let alias = memory.reference(head, 0)
memory.drop(tail)
memory.use_reference(alias)
memory.expect_byte(head, 0, 1)
memory.drop(head)
memory.close(r)
