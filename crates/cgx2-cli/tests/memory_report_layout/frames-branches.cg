fn worker(flag: i64) -> Unit effects(ManagedAlloc, Mutate):
    let r = memory.region(mode: manual, limit: 1048576)
    let head = memory.alloc_object(r, 24, 256)
    let tail = memory.alloc_object(r, 24, 2)
    memory.write_byte(head, 0, 67)
    memory.write_byte(head, 1, 71)
    memory.write_byte(head, 2, 71)
    memory.write_byte(head, 3, 49)
    memory.write_byte(head, 5, 1)
    memory.write_byte(head, 12, 255)
    memory.write_byte(tail, 0, 67)
    memory.write_byte(tail, 1, 71)
    memory.write_byte(tail, 2, 71)
    memory.write_byte(tail, 3, 49)
    memory.write_byte(tail, 5, 1)
    memory.write_byte(tail, 12, 1)
    memory.set_reference(head, 0, tail)
    if flag == 0:
        let scratch = memory.alloc_bytes(r, 1)
        memory.drop(scratch)
        memory.expect_byte(head, 0, 0)
    else:
        memory.expect_byte(head, 0, 67)
    memory.drop(head)
    memory.drop(tail)
    memory.close(r)

fn main() -> Unit effects(ManagedAlloc, Mutate):
    let r = memory.region(mode: manual, limit: 4096)
    let outer = memory.alloc_object(r, 1, 1)
    memory.set_reference(outer, 0, outer)
    worker(0)
    memory.drop(outer)
    memory.close(r)
