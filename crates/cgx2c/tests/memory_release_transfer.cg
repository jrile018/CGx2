fn main() -> Unit effects(ManagedAlloc, Mutate):
    let source = memory.region(mode: manual, limit: 1024)
    let destination = memory.region(mode: auto, limit: 1024)
    let owned = memory.owned_bytes(4)
    let original = memory.promote_owned(source, owned)
    let copied = memory.copy_to_owned(original)
    let transferred = memory.promote_owned(destination, copied)
    memory.use(original)
    memory.use(transferred)
    memory.drop(original)
    memory.close(source)
    memory.use(transferred)
    memory.drop(transferred)
    memory.close(destination)
