let left = memory.region(mode: manual, limit: 1024)
let right = memory.region(mode: manual, limit: 1024)
let parent = memory.alloc_object(left, 8, 1)
let child = memory.alloc_object(left, 4, 0)
memory.set_reference(parent, 0, child)
let foreign = memory.alloc_object(right, 4, 0)
memory.set_reference(parent, 0, foreign)
