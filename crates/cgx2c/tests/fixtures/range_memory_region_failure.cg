let r = memory.region(mode: manual, limit: 195)
let outer = memory.alloc_bytes(r, 1)
for i in range(0, 4):
    let t = memory.alloc_bytes(r, 1)
    if i >= 1:
        let extra = memory.alloc_bytes(r, 1)
        memory.drop(extra)
    else:
        memory.use(t)
    memory.drop(t)
memory.drop(outer)
memory.close(r)
