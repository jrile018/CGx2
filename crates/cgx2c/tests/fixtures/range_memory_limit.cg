fn leaf(n: i64) -> Unit effects(ManagedAlloc, Mutate):
    let marker = memory.owned_bytes(0)
    for j in range(0, n):
        if false:
            let t = memory.owned_bytes(0)
            memory.drop(t)
        else:
            memory.use(marker)
    memory.drop(marker)
fn main() -> Unit effects(ManagedAlloc, Mutate):
    let r = memory.region(mode: manual, limit: 1024)
    let x = memory.alloc_bytes(r, 1)
    for i in range(0, 10):
        leaf(10000)
    memory.drop(x)
    memory.close(r)
