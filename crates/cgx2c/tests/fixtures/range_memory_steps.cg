let r = memory.region(mode: manual, limit: 1024)
let outer = memory.alloc_bytes(r, 1)
for i in range(0, 100000):
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
    memory.use(outer)
memory.drop(outer)
memory.close(r)
