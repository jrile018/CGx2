let r = memory.region(mode: manual, limit: 8388608)
let graph = memory.alloc_graph(r, 1048576, 65536)
memory.expect_graph_byte(graph, 1048551, 0)
memory.write_graph_byte(graph, 1048551, 41)
memory.write_graph_byte(graph, 1048552, 42)
memory.write_graph_byte(graph, 1048575, 43)
memory.expect_graph_byte(graph, 1048551, 41)
memory.expect_graph_byte(graph, 1048552, 42)
memory.expect_graph_byte(graph, 1048575, 43)
memory.set_graph_reference(graph, 65535, graph)
let cycle = memory.graph_reference(graph, 65535)
memory.collect(r)
memory.use_reference(cycle)
memory.drop(graph)
memory.collect(r)
memory.close(r)
