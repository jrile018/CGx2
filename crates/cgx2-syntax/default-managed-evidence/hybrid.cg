record R:
    value: i64

fn heap() -> i64 effects(ManagedAlloc):
    let result = managed.try_alloc([1, 2, 3])
    match result:
        Result.Ok(xs):
            length(xs)
        Result.Err(error):
            42

fn main() -> i64:
    let old = owned(R(value: 7))
    no_gc(budget: 0):
        let result = try_owned(R(value: 2))
        match result:
            Result.Ok(owner):
                return 0
            Result.Err(error):
