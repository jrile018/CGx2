record Node:
    next: managed.Ref<Option<Node>>

fn cycle() -> Unit effects(ManagedAlloc, Mutate):
    let cell: managed.Ref<Option<Node>> = managed.ref(Option<Node>.None())
    let node = Node(next: cell)
    managed.set(cell, Option.Some(node))

fn main() -> i64 effects(ManagedAlloc, Mutate, Collect) caps(MemoryCollect):
    cycle()
    managed.collect()
    42
