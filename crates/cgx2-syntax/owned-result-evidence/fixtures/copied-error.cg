record R:
    x: i64
fn observe(error: AllocationError) -> i64:
    let mut snapshot = error
    snapshot = error
    match snapshot:
        AllocationError.BudgetExceeded():
            42
        AllocationError.RegionLimit():
            2
        AllocationError.HostAllocation():
            3
        AllocationError.InvalidRegion():
            4
        AllocationError.ShapeLimit():
            5
fn main() -> i64:
    no_gc(budget: 0):
        match try_owned(R(x: 9)):
            Result.Ok(p):
                return p.x
            Result.Err(e):
                return observe(e)
