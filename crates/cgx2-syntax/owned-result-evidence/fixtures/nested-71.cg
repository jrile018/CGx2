record R:
    x: i64
fn allocate() -> Result<owned<R>, AllocationError>:
    try_owned(R(x: 42))
fn main() -> i64:
    no_gc(budget: 71):
        no_gc(budget: 40):
            match allocate():
                Result.Ok(p):
                    return p.x
                Result.Err(e):
                    return 42
