record R:
    x: i64
fn inspect(q: Result<owned<R>, AllocationError>) -> i64:
    match q:
        Result.Ok(p):
            p.x
        Result.Err(e):
            match e:
                AllocationError.BudgetExceeded():
                    42
                AllocationError.RegionLimit():
                    2
                AllocationError.HostAllocation():
                    3
                AllocationError.InvalidRegion():
                    4
                AllocationError.ShapeLimit():
                    5
fn main() -> i64:
    no_gc(budget: 40):
        return inspect(try_owned(R(x: 9)))
