record R:
    x: i64
    y: i64
record Counter:
    x: i64
fn next(p: exclusive<Counter>) -> i64:
    p.x += 1
    p.x
fn main() -> i64:
    let counter = owned(Counter(x: 0))
    match try_owned(R(y: next(borrow_mut(counter)), x: next(borrow_mut(counter)))):
        Result.Ok(p):
            return p.y * 10 + p.x
        Result.Err(e):
            return 0
