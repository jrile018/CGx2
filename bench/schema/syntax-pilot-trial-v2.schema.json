{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGx2 isolated public syntax trial trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "variant", "model_family", "model_version", "model_settings", "seed", "order_position", "export_manifest_sha256", "visible_files", "transcript", "provider_usage_records", "output_tokens", "input_tokens", "elapsed_wall_seconds", "repair_iterations", "human_interventions", "final_source", "final_source_sha256", "compiler_success", "test_success", "verification_ref", "isolation", "operator_authentication", "token_budget", "time_budget_seconds"],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["indent", "brace"]},
    "model_family": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "model_settings": {"type": "object", "additionalProperties": false, "required": ["temperature", "top_p", "max_output_tokens"], "properties": {"temperature": {"type": "number", "minimum": 0}, "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "max_output_tokens": {"type": "integer", "minimum": 1}}},
    "seed": {"type": "integer", "minimum": 0},
    "order_position": {"enum": [1, 2]},
    "export_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visible_files": {"type": "object", "additionalProperties": {"type": "string"}},
    "transcript": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": {"role": {"enum": ["system", "user", "assistant", "tool"]}, "content": {"type": "string"}}}},
    "provider_usage_records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider", "response_id", "input_tokens", "output_tokens", "raw_response"], "properties": {"provider": {"type": "string", "minLength": 1}, "response_id": {"type": "string", "minLength": 1}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "raw_response": {"type": "string", "minLength": 1}}}},
    "output_tokens": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "elapsed_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "repair_iterations": {"type": "integer", "minimum": 0},
    "human_interventions": {"const": 0},
    "final_source": {"type": "string", "minLength": 1},
    "final_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_success": {"type": "boolean"},
    "test_success": {"type": "boolean"},
    "verification_ref": {"type": "string", "minLength": 1},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["status", "cgroup_cpu", "cgroup_memory", "cgroup_pids", "private_unmounted", "network_disabled", "grader_separate_process"], "properties": {"status": {"const": "pass"}, "cgroup_cpu": {"const": true}, "cgroup_memory": {"const": true}, "cgroup_pids": {"const": true}, "private_unmounted": {"const": true}, "network_disabled": {"const": true}, "grader_separate_process": {"const": true}}},
    "operator_authentication": {"type": "object", "additionalProperties": false, "required": ["provider_receipts_verified", "isolation_receipt_verified", "grader_ref_verified"], "properties": {"provider_receipts_verified": {"const": true}, "isolation_receipt_verified": {"const": true}, "grader_ref_verified": {"const": true}}},
    "token_budget": {"type": "integer", "minimum": 1},
    "time_budget_seconds": {"type": "number", "exclusiveMinimum": 0}
  }
}
