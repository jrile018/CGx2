{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgx2.invalid/schema/release-evidence-v1",
  "title": "Immutable CGx2 release evidence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "operator", "provenance", "jobs", "imports", "plan"],
  "properties": {
    "schema_version": {"const": 1},
    "purpose": {"enum": ["release", "fixture"]},
    "operator": {"type": "string", "minLength": 1},
    "plan": {"$ref": "#/$defs/digest"},
    "imports": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "tools", "interpreter", "compiler", "environment", "git_head"],
      "properties": {
        "source": {"$ref": "#/$defs/digest"},
        "tools": {"$ref": "#/$defs/digest"},
        "interpreter": {"$ref": "#/$defs/digest"},
        "compiler": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "environment": {"$ref": "#/$defs/digest"},
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optionalDigest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd", "exit_code", "reason", "executable_sha256", "wall_seconds", "stdout", "stderr", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "reason": {"enum": [null, "timeout", "output_limit"]},
        "executable_sha256": {"$ref": "#/$defs/digest"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "stdout": {"$ref": "#/$defs/digest"},
        "stderr": {"$ref": "#/$defs/digest"},
        "environment": {"$ref": "#/$defs/digest"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter", "gate", "command", "result", "artifacts", "review", "blocker"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "adapter": {"enum": ["isolation-probe", "isolation-selftest", "score", "public-export", "task-study", "syntax-trace", "native-runtime", "libtorch-runtime", "owner"]},
        "gate": {"type": "string", "minLength": 1},
        "command": {"anyOf": [{"$ref": "#/$defs/command"}, {"type": "null"}]},
        "result": {"$ref": "#/$defs/optionalDigest"},
        "review": {"$ref": "#/$defs/optionalDigest"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "blocker": {"type": ["string", "null"]}
      }
    }
  }
}
