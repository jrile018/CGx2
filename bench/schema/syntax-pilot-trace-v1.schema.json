{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGx2 public paired syntax pilot trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "variant", "model_family", "model_version", "seed", "usage_provenance", "input_tokens", "output_tokens", "tool_tokens", "diagnostic_tokens", "total_tokens", "elapsed_wall_seconds", "repair_iterations", "human_interventions", "source_bytes", "source_sha256", "verified_outcome", "verification_ref", "token_budget", "time_budget_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["indent", "brace"]},
    "model_family": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "usage_provenance": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "provider", "record_id"], "properties": {"kind": {"const": "provider_usage"}, "provider": {"type": "string", "minLength": 1}, "record_id": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "implementation", "version", "token_ids_sha256"], "properties": {"kind": {"const": "local_tokenizer"}, "implementation": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "token_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ]
    },
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "tool_tokens": {"type": "integer", "minimum": 0},
    "diagnostic_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "elapsed_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
    "repair_iterations": {"type": "integer", "minimum": 0},
    "human_interventions": {"type": "integer", "minimum": 0},
    "source_bytes": {"type": "integer", "minimum": 0},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verified_outcome": {"enum": ["pass", "fail", "timeout"]},
    "verification_ref": {"type": "string", "minLength": 1},
    "token_budget": {"type": "integer", "minimum": 1},
    "time_budget_seconds": {"type": "number", "exclusiveMinimum": 0}
  }
}
