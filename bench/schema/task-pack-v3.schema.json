{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cgx2:bench:task-pack:v3",
  "title": "CGx2 task definitions and preregistered external runs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "protocol",
    "tasks",
    "expected_runs"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "kind": {
      "enum": [
        "candidate_pack",
        "holdout"
      ]
    },
    "protocol": {
      "type": "object",
      "description": "Freeze exact SHA-256 pins, budgets, tool version, hardware and randomization seed before a holdout run."
    },
    "freeze": {
      "type": "object",
      "required": [
        "task_set_sha256",
        "run_grid_sha256",
        "protocol_sha256",
        "frozen_at_utc"
      ],
      "properties": {
        "task_set_sha256": {
          "$ref": "#/$defs/sha"
        },
        "run_grid_sha256": {
          "$ref": "#/$defs/sha"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha"
        },
        "frozen_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "expected_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "task_id",
          "language",
          "model_family",
          "model_version",
          "seed",
          "order"
        ],
        "properties": {
          "run_id": {
            "$ref": "#/$defs/text"
          },
          "task_id": {
            "$ref": "#/$defs/text"
          },
          "language": {
            "$ref": "#/$defs/language"
          },
          "model_family": {
            "$ref": "#/$defs/text"
          },
          "model_version": {
            "$ref": "#/$defs/text"
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "language": {
      "enum": [
        "cgx2",
        "python",
        "rust",
        "typescript",
        "ocaml"
      ]
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "status",
        "tier",
        "category",
        "acceptance_criteria",
        "baseline_language",
        "baseline_rationale",
        "applicable_languages",
        "exclusions",
        "hidden_test_ref",
        "author_id",
        "review_records",
        "planned_repository_files",
        "prompt_path",
        "prompt_sha256",
        "hidden_test_path",
        "hidden_test_sha256",
        "repository_snapshots",
        "workspace_paths",
        "acceptance_command",
        "build_commands",
        "run_commands",
        "allowed_tools",
        "allowed_docs",
        "feature_scope",
        "expected_outcomes",
        "equivalence",
        "reference_paths",
        "reference_snapshots"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "candidate",
            "frozen"
          ]
        },
        "tier": {
          "enum": [
            "small",
            "large"
          ]
        },
        "planned_repository_files": {
          "type": "integer",
          "minimum": 3,
          "maximum": 100
        },
        "category": {
          "enum": [
            "memory_sensitive",
            "package_api",
            "native_c",
            "notebook_comprehension",
            "proof_interpretation",
            "numerical_edge"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "baseline_language": {
          "enum": [
            "python",
            "rust",
            "typescript",
            "ocaml"
          ]
        },
        "baseline_rationale": {
          "$ref": "#/$defs/text"
        },
        "applicable_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "hidden_test_ref": {
          "$ref": "#/$defs/text"
        },
        "hidden_test_path": {
          "$ref": "#/$defs/text"
        },
        "hidden_test_sha256": {
          "$ref": "#/$defs/sha"
        },
        "repository_snapshots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha"
          }
        },
        "workspace_paths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "reviewer_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "author_id": {
          "$ref": "#/$defs/text"
        },
        "review_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/text"
              },
              "sha256": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "prompt_path": {
          "$ref": "#/$defs/text"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "acceptance_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "build_commands": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "run_commands": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "allowed_docs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "feature_scope": {
          "type": "object",
          "required": [
            "memory",
            "foreign",
            "syntax"
          ],
          "properties": {
            "memory": {
              "$ref": "#/$defs/text"
            },
            "foreign": {
              "$ref": "#/$defs/text"
            },
            "syntax": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "expected_outcomes": {
          "type": "object",
          "required": [
            "starter",
            "reference"
          ],
          "properties": {
            "starter": {
              "$ref": "#/$defs/text"
            },
            "reference": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "equivalence": {
          "type": "object",
          "required": [
            "shared_prompt",
            "same_cases_ref",
            "input_domain",
            "output_rule",
            "known_limit",
            "baseline_selected_before_traces"
          ],
          "properties": {
            "shared_prompt": {
              "$ref": "#/$defs/text"
            },
            "same_cases_ref": {
              "$ref": "#/$defs/text"
            },
            "input_domain": {
              "$ref": "#/$defs/text"
            },
            "output_rule": {
              "$ref": "#/$defs/text"
            },
            "known_limit": {
              "$ref": "#/$defs/text"
            },
            "baseline_selected_before_traces": {
              "type": "boolean"
            }
          }
        },
        "reference_paths": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "reference_snapshots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    }
  }
}
