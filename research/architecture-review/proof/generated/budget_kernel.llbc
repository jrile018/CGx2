y/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/tmp/cgx2-arch-review-proof/kernel-source.rs"},"crate_name":"budget_kernel","contents":"use crate::{AllocationError, Session};\n\n#[derive(Clone, Copy)]\npub(crate) struct Budget {\n    pub limit: usize,\n    pub spent: usize,\n}\n\nimpl Session {\n    pub(crate) fn check_budgets(&self, bytes: usize) -> Result<(), AllocationError> {\n        for budget in &self.budgets {\n            if bytes > budget.limit.saturating_sub(budget.spent) {\n                return Err(AllocationError::BudgetExceeded);\n            }\n        }\n        Ok(())\n    }\n\n    pub(crate) fn charge_budgets(&mut self, bytes: usize) {\n        self.charged_bytes_v2 = self.charged_bytes_v2.saturating_add(bytes as u128);\n        for budget in &mut self.budgets {\n            budget.spent += bytes;\n        }\n    }\n}\n"},{"id":14,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/result.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/slice/iter.rs"},"crate_name":"core","contents":null},{"id":17,"name":{"Local":"/rustc/library/core/src/slice/iter/macros.rs"},"crate_name":"core","contents":null},{"id":18,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":19,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":20,"name":{"Local":"/rustc/library/core/src/intrinsics/mod.rs"},"crate_name":"core